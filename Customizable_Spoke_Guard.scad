module divider_fillet(ring_radius, direction, radius) {
    contact_radius = ring_radius - direction * 0.01;
    centre_radius = contact_radius + direction * radius;
    centre = [sqrt(centre_radius * centre_radius - radius * radius), radius];
    contact_angle = atan2(radius, centre[0]);
    end_angle = direction > 0 ? contact_angle - 180 : contact_angle;
    ring_overlap = centre + xy(end_angle, radius) - xy(contact_angle, direction * 0.25);

    polygon(concat(
        [[centre[0], -0.25]],
        [for (step = [0:24])
            centre + xy(-90 + (end_angle + 90) * step / 24, radius)],
        [ring_overlap, [ring_overlap[0], -0.25]]
    ));
}

