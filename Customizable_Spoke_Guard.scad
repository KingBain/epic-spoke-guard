/*
 * Customizable 210 mm spoke guard
 *
 * Open this file in OpenSCAD. Edit the settings in Customizer or below.
 * Press F5 to preview and F6 to render, then use File > Export > Export as STL.
 *
 * Separate text groups with |. For example, MUST|GO|NOW uses three text
 * groups and three dividers. Spaces inside a group stay together. Empty
 * groups are skipped. Supported text is A-Z, 0-9, spaces, and . , ! ? & ' - + /.
 * Lowercase renders as uppercase. The original Open Sans ExtraBold outlines
 * are embedded. Cap height starts at 25.55 mm measured radially. The
 * layout tightens letter spacing first, then reduces the font size as needed.
 * With floating dividers the groups share the available arc. With fixed
 * dividers each group fits its own sector.
 *
 * Set show_dividers to false to remove all dividers. Turn float_dividers off
 * for equal angular spacing. The model uses at least two sections. With
 * blank text and the dividers off, the inner disc and rim are separate pieces.
 *
 * The Centre hub settings control the hole diameter and the height from the
 * print-bed face to the top of the shoulder. Both are measured in mm. The
 * shoulder can be lowered to the surface of the centre web (1.455 mm).
 *
 * For two colours, export Black body and White letter faces using the same
 * settings, then import both STLs as parts of one object.
 * The white faces span Z = 1.818-2.00 mm. The rear letter recess is 0.02 mm.
 */

/* [Lettering] */
// Separate text groups with |. Spaces within a group are kept.
rim_text = "EAT PASTA,|RIDE FASTA";

/* [Dividers] */
// Show the rounded three-slot dividers.
show_dividers = true;
// Fit the dividers between the text groups. Turn off for equal angular spacing.
float_dividers = true;

/* [Centre hub] */
// Nominal diameter of the centre hole (mm).
center_hole_diameter = 34.8; // 0.01
// Height from the print-bed face to the top of the shoulder (mm).
center_shoulder_height = 5.0; // 0.01

/* [Export] */
// Export the whole guard or one of the two colour parts.
export_part = "Complete guard"; // [Complete guard,Black body,White letter faces]

/* [Hidden] */

$fn = 360;

body_z = 3.2;
colour_z = 4.0;
letter_z = 4.4;
// The approved STL scales the original profile from 11 mm to 5 mm in Z.
original_hub_height = 11;
z_scale = 5 / original_hub_height;
rear_inset_depth = 0.02;
original_bore_diameter = 34.8;
web_height = body_z * z_scale;
// The seating face narrows to 43.42 mm across its shortest chord.
max_bore_diameter = 43.4;

inner_text_radius = 72.35;
outer_text_radius = 97.9;
text_height = outer_text_radius - inner_text_radius;
tracking = 150;
min_tracking = 70;
min_ink_gap = 100;
space_advance = 730;
fillet_radius = 2;
// Angular clearance for a divider, its fillets, and the adjacent letter bridges.
divider_spacing = 30.6;

function uppercase(character) =
    ord(character) >= ord("a") && ord(character) <= ord("z")
    ? chr(ord(character) - ord("a") + ord("A"))
    : character;

function uppercase_text(phrase, index = 0) =
    index == len(phrase) ? "" : str(uppercase(phrase[index]), uppercase_text(phrase, index + 1));

function glyph_for(character, label) =
    let(matches = search([character], glyph_table, 0)[0])
    assert(len(matches) > 0, str(label, " uses an unsupported character: ", character))
    glyph_table[matches[0]];

// Entries carry the original glyph and its horizontal origin in font units.
function position_glyphs(glyphs, tracking, index = 0, cursor = 0, last_ink = undef) =
    index == len(glyphs) ? [] :
    is_undef(glyphs[index])
        ? position_glyphs(glyphs, tracking, index + 1, cursor + space_advance, last_ink)
        : let(
            glyph = glyphs[index],
            origin = is_undef(last_ink) ? cursor : max(cursor, last_ink + min_ink_gap - glyph[2])
        ) concat([[glyph, origin]], position_glyphs(
            glyphs, tracking, index + 1, origin + glyph[1] + tracking, origin + glyph[3]
        ));

function left_edge(entries) = entries[0][0][2] + entries[0][1];
function right_edge(entries) =
    let(last = entries[len(entries) - 1]) last[0][3] + last[1];

function ink_width(entries) = len(entries) == 0 ? 0 : right_edge(entries) - left_edge(entries);

function split_groups(text, index = 0, current = "") =
    index == len(text) ? [current] :
    text[index] == "|"
        ? concat([current], split_groups(text, index + 1))
        : split_groups(text, index + 1, str(current, text[index]));

function glyphs_for(phrase, group_index) = len(phrase) == 0 ? [] : [
    for (i = [0 : len(phrase) - 1])
            phrase[i] == " " ? undef : glyph_for(phrase[i], str("Text group ", group_index + 1))
];

