module body_before_recess(hub_height) {
    scale([1, 1, hub_height / original_hub_height]) {
        cassette_hub();
        // Fill the original opening before cutting a smaller bore.
        if (center_hole_diameter < original_bore_diameter)
            cylinder(d = original_bore_diameter + 1, h = original_hub_height, $fn = 120);
    }
    linear_extrude(body_z, convexity = 12) guard_face();
    translate([0,0,body_z - 0.05])
        linear_extrude(colour_z - body_z + 0.05, convexity = 8) backing();
    shoulder_ridges();
}

module black_body() {
    cutter_overlap = 0.10;
    assert(is_num(center_hole_diameter) && center_hole_diameter > 0
        && center_hole_diameter <= max_bore_diameter,
        str("Centre hole diameter must be greater than 0 and at most ", max_bore_diameter, " mm."))
    assert(is_num(center_shoulder_height) && center_shoulder_height >= web_height,
        str("Centre shoulder height must reach the web surface at ", web_height, " mm."))
    let(hub_height = center_shoulder_height / z_scale)
    difference() {
        body_before_recess(hub_height);
        if (center_hole_diameter != original_bore_diameter)
            translate([0,0,-cutter_overlap])
                cylinder(d = center_hole_diameter, h = max(hub_height, body_z) + 2 * cutter_overlap);
        // Use the front glyphs at the same XY positions. They read mirrored
        // from behind, with the 0.50 mm backing edge forming the recess wall.
        translate([0,0,-cutter_overlap])
            linear_extrude(cutter_overlap + rear_inset_depth / z_scale, convexity = 8)
                rim_lettering();
    }
}

module white_faces(overlap = 0) {
    translate([0,0,colour_z - overlap])
        linear_extrude(letter_z - colour_z + overlap, convexity = 8) rim_lettering();
}

