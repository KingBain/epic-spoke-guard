// Keep the two original text scales for the two-section layout.
// Layouts with more sections use the same scale for every group.
top_scale = 127 / 12765;
bottom_scale = 137 / 12968;
parsed = split_groups(uppercase_text(rim_text));
groups = [
    for (i = [0 : len(parsed) - 1])
        let(glyphs = glyphs_for(parsed[i], i))
        if (len([for (glyph = glyphs) if (!is_undef(glyph)) 1]) > 0)
            [parsed[i], glyphs]
];

// Use one divider per text group once there are at least two groups.
group_count = len(groups);
section_count = max(2, group_count);
section_step = 360 / section_count;

function group_scale(index) = section_count == 2 && index == 1 ? bottom_scale : top_scale;

function layout_with_tracking(spacing) = [
    for (i = [0 : section_count - 1])
        let(
            has_text = i < group_count,
            entries = has_text ? position_glyphs(groups[i][1], spacing) : [],
            scale = group_scale(i)
        ) [entries, scale, ink_width(entries) * scale, 1]
];

function widths_before(layout, index) =
    index == 0 ? 0 : layout[index - 1][2] + widths_before(layout, index - 1);

layout_span = 360 - section_count * divider_spacing;
sector_span = section_step - divider_spacing;

function layout_fits(layout) =
    float_dividers
        ? widths_before(layout, section_count) <= layout_span
        : max([for (section = layout) section[2]]) <= sector_span;

function fit_tracking(lower, upper) =
    lower == upper ? layout_with_tracking(lower) :
    let(mid = ceil((lower + upper) / 2), candidate = layout_with_tracking(mid))
    layout_fits(candidate) ? fit_tracking(mid, upper) : fit_tracking(lower, mid - 1);

function fit_layout() =
    let(regular = layout_with_tracking(tracking), compact = layout_with_tracking(min_tracking))
    assert(sector_span > 0,
        "There are too many text groups to leave room for the dividers. Use fewer groups separated by |.")
    layout_fits(regular) ? regular :
    layout_fits(compact) ? fit_tracking(min_tracking, tracking) :
    let(shared_scale = float_dividers ? layout_span / widths_before(compact, section_count) : 1)
    [
        for (section = compact)
            let(font_scale = float_dividers || section[2] <= sector_span
                ? shared_scale
                : sector_span / section[2])
            [section[0], section[1] * font_scale, section[2] * font_scale, font_scale]
    ];

layout = fit_layout();
gap = (360 - widths_before(layout, section_count)) / section_count;
first_edge = 90 + layout[0][2] / 2;

function section_centre(index) = float_dividers
    ? first_edge - widths_before(layout, index) - index * gap - layout[index][2] / 2
    : 90 - index * section_step;

function divider_angle(index) = float_dividers
    ? section_centre(index) - layout[index][2] / 2 - gap / 2
    : section_centre(index) - section_step / 2;

function midpoint(entries) = len(entries) == 0 ? 0 : (left_edge(entries) + right_edge(entries)) / 2;

// Move the lower line inward only when a descender would reach the outer edge.
function inward_shift(entries, font_scale) =
    let(minimum = min(concat([0], [for (entry = entries, outline = entry[0][5], point = outline) point[1]])))
    let(outer_edge = outer_text_radius - text_height * ((1 - font_scale) / 2 + font_scale * minimum / cap_height))
    max(0, outer_edge - 104.35);

function wrap_angle(x, upper, scale, centre) =
    upper ? 90 - scale * (x - centre) : -90 + scale * (x - centre);

function wrap_radius(y, upper, font_scale, shift) =
    let(offset_from_baseline = text_height * ((1 - font_scale) / 2 + font_scale * y / cap_height))
    upper ? inner_text_radius + offset_from_baseline
          : outer_text_radius - offset_from_baseline - shift;

function xy(angle, radius) = [radius * cos(angle), radius * sin(angle)];

module wrapped_outline(outline, origin, upper, scale, font_scale, centre, shift) {
    polygon([for (point = outline) xy(
        wrap_angle(origin + point[0], upper, scale, centre),
        wrap_radius(point[1], upper, font_scale, shift)
    )]);
}

module phrase_letters(entries, upper, scale, font_scale) {
    centre = midpoint(entries);
    shift = upper ? 0 : inward_shift(entries, font_scale);

    for (entry = entries) {
        glyph = entry[0];
        outlines = glyph[5];
        difference() {
            union() {
                for (i = [0 : glyph[4] - 1])
                    wrapped_outline(outlines[i], entry[1], upper, scale, font_scale, centre, shift);
            }
            if (glyph[4] < len(outlines))
                for (i = [glyph[4] : len(outlines) - 1])
                    wrapped_outline(outlines[i], entry[1], upper, scale, font_scale, centre, shift);
        }
    }
}

// Find the ink intervals at a given height to place each bridge inside a stroke.
function crossings_at(outlines, y) = [
    for (outline = outlines, i = [0 : len(outline) - 1])
        let(a = outline[i], b = outline[(i + 1) % len(outline)])
        if (min(a[1], b[1]) <= y && y < max(a[1], b[1]))
            a[0] + (b[0] - a[0]) * (y - a[1]) / (b[1] - a[1])
];

function sorted(values) =
    len(values) < 2 ? values :
    let(pivot = values[floor(len(values) / 2)])
    concat(
        sorted([for (value = values) if (value < pivot) value]),
        [for (value = values) if (value == pivot) value],
        sorted([for (value = values) if (value > pivot) value])
    );

function widest(intervals, i = 1, best = 0) =
    i == len(intervals) ? intervals[best] :
    widest(intervals, i + 1,
        intervals[i][1] - intervals[i][0] > intervals[best][1] - intervals[best][0] ? i : best);

function bridge_anchors(character) =
    character == "," ? [[0.06, false]] :
    character == "." ? [[0.12, false]] :
    character == "'" ? [[0.80, true]] :
    character == "-" ? [[0.375, false], [0.375, true]] :
    character == "+" ? [[0.50, false], [0.50, true]] :
    character == "!" || character == "?" ? [[0.12, false], [0.915, true]] :
    [[0.085, false], [0.915, true]];

module phrase_bridges(entries, upper, scale, font_scale) {
    centre = midpoint(entries);
    shift = upper ? 0 : inward_shift(entries, font_scale);

    for (entry = entries, anchor = bridge_anchors(entry[0][0])) {
        glyph = entry[0];
        y = cap_height * anchor[0];
        crossings = sorted(crossings_at(glyph[5], y));
        intervals = len(crossings) < 2 ? [] : [
            for (i = [0 : 2 : len(crossings) - 2]) [crossings[i], crossings[i + 1]]
        ];

        if (len(intervals) > 0) {
            // Split the bridge across both feet where the reference design did.
            split_feet = !anchor[1] && (glyph[0] == "A" || glyph[0] == "W");
            radius = wrap_radius(y, upper, font_scale, shift);
            end_radius = upper != anchor[1] ? 68.7 : 101.9;

            for (interval = split_feet ? intervals : [widest(intervals)]) {
                angle = wrap_angle(entry[1] + (interval[0] + interval[1]) / 2, upper, scale, centre);
                stroke_width = radius * scale * (PI / 180) * (interval[1] - interval[0]);
                bridge_width = min(4.35, max(2.55, stroke_width * 0.67));
                hull() {
                    translate(xy(angle, radius)) circle(d = bridge_width, $fn = 24);
                    translate(xy(angle, end_radius)) circle(d = bridge_width, $fn = 24);
                }
            }
        }
    }
}

module rim_lettering(bridges = false) {
    for (i = [0 : section_count - 1]) {
        entries = layout[i][0];
        scale = layout[i][1];
        font_scale = layout[i][3];
        angle = section_centre(i);
        upper = sin(angle) >= 0;

        if (len(entries) > 0)
            rotate(angle - (upper ? 90 : -90)) {
                if (!bridges)
                    phrase_letters(entries, upper, scale, font_scale);
                else if (section_count == 2 && i == 0 && groups[i][0] == "EAT PASTA,"
                         && font_scale == 1 && abs(layout[i][2] - 127) < 0.001)
                    original_top_bridges();
                else if (section_count == 2 && i == 1 && groups[i][0] == "RIDE FASTA"
                         && font_scale == 1 && abs(layout[i][2] - 137) < 0.001)
                    original_bottom_bridges();
                else
                    phrase_bridges(entries, upper, scale, font_scale);
            }
    }
}

